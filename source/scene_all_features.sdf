# ---------- materials ----------
# ƒелаем серый материал двусторонним и чуть повышаем ambient,
# чтобы обратные стороны никогда не были совсем чЄрными.
material grey   kd 0.72 0.72 0.75 ks 0.10 0.10 0.10 ka 0.22 shininess 16 two_sided
material red    kd 0.90 0.15 0.15 ks 0.20 0.20 0.20 ka 0.05 shininess 32
material green  kd 0.15 0.85 0.20 ks 0.20 0.20 0.20 ka 0.05 shininess 32
material mirror kd 0.0  0.0  0.0  ks 0.90 0.90 0.90 ka 0.00 shininess 256 reflect 0.85
material glass  kd 0.22 0.24 0.27 ks 0.90 0.90 0.90 ka 0.00 shininess 128 reflect 0.06 refract 0.84 ior 1.5

# ---------- primitives ----------
#  омната-Ђстуди€ї: пол, задн€€/боковые стены + потолок и дальн€€ панель дл€ при€тных отражений.
define shape box floor       -40 -2  -80   40 -1   -5  grey
define shape box backwall    -40 -2  -35   40  30 -34  grey
define shape box leftwall    -40 -2  -70  -39  30 -10  grey
define shape box rightwall    39 -2  -70   40  30 -10  grey
define shape box ceiling     -40 29  -80   40  30  -5  grey
define shape box frontpanel  -40 -2  -85   40  15 -84  grey

define shape sphere s_mirror -10 0 -25 2.6 mirror
define shape sphere s_glass    0 0 -26 2.6 glass
define shape sphere s_red      8  0 -24 2.2 red

# Ќевысока€ зелЄна€ подставка Ч гарантированно в кадре
define shape box pedestal -1 -0.3 -1  1 0.3 1  green translate 0 -1.2 -23

# ---------- scene graph ----------
define shape composite root floor backwall leftwall rightwall ceiling frontpanel s_mirror s_glass s_red pedestal

# ---------- lights ----------
# ¬ерхний основной свет (HDR) + две боковые + м€гка€ подсветка снизу
light  0  18 -22 1800 1800 1800
light -12 10 -18  700  600  600
light  14 10 -18  600  600  800
light   0  -8 -20  160  160  190   # fill-свет снизу, чтобы исключить тЄмные отражени€

# ---------- camera ----------
camera main 60   0 0 0   0 0 -1   0 1 0

# ---------- background ----------
background 0.23 0.23 0.26
