# --- материалы ---
# Отражающий металл
material mirror kd 0.0 0.0 0.0 ks 0.9 0.9 0.9 ka 0.0 shininess 256 reflect 1.0
# Стекло (преломление + отражение)
material glass kd 0.1 0.1 0.1 ks 0.9 0.9 0.9 ka 0.0 shininess 128 reflect 0.1 refract 0.9 ior 1.5
# Цветные диффузные материалы
material red   kd 0.9 0.1 0.1 ks 0.2 0.2 0.2 ka 0.05 shininess 32
material green kd 0.1 0.9 0.1 ks 0.2 0.2 0.2 ka 0.05 shininess 32
material blue  kd 0.1 0.1 0.9 ks 0.2 0.2 0.2 ka 0.05 shininess 32
material grey  kd 0.7 0.7 0.7 ks 0.1 0.1 0.1 ka 0.05 shininess 16

# --- пол (для отражений) ---
define shape box floor -50 -2 -50  50 -1 50 grey

# --- сфера стеклянная (преломление) ---
define shape sphere glass_sphere 0 0 -15 2 glass

# --- сфера зеркальная (отражение) ---
define shape sphere mirror_sphere -4 0 -15 2 mirror

# --- цветная сфера (для отражения и преломления) ---
define shape sphere red_sphere 4 0 -15 2 red

# --- тест трансформаций: наклонённый и масштабированный куб ---
define shape box cube -1 -1 -1 1 1 1 green translate 0 -1 -10 scale 2 0.5 2 rotateY 30 rotateX 15

# --- composite: сгруппируем стеклянную и красную сферы ---
define shape composite group glass_sphere red_sphere translate 0 0 -5 rotateY 20

# --- корень сцены ---
define shape composite root floor mirror_sphere cube group

# --- освещение ---
light -10 15 -10 400 400 400
light  10 15 -5  200 200 300

# --- камера ---
camera cam1 60   0 3 5    0 -0.2 -1    0 1 0

# --- фон ---
background 0.2 0.2 0.25
